# Never commit real values. Rotate any token that was pasted into chat.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_string
TELEGRAM_WEBHOOK_URL=https://budget.example.com/telegram/webhook
TELEGRAM_DELIVERY_MODE=polling
OPENAI_API_KEY=replace_me

DATABASE_URL=postgresql+asyncpg://family_bot:change_me@postgres:5432/family_bot
POSTGRES_PASSWORD=replace_with_long_random_password
APP_TIMEZONE=Asia/Bangkok
BASE_CURRENCY=KZT
DEFAULT_SPENDING_CURRENCY=THB
OPENAI_RECEIPT_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5.6-sol
OPENAI_INTENT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
RECEIPT_STORAGE_PATH=/data/receipts

# Production allowlist. Use SETUP_MODE=true temporarily and /ids to learn IDs.
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_MEMBER_USER_ID=
SETUP_MODE=false

DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=0
FINANCIAL_CYCLE_START_DAY=5
AUTO_SEED=true
LOG_LEVEL=INFO
